TMDB_API_KEY=your_tmdb_api_key_here
# Optional: last-resort series lookup for titles TMDB doesn't know
TVDB_API_KEY=
# Optional: powers the ratings-comparison charts (IMDb, Rotten Tomatoes, Metacritic)
OMDB_API_KEY=
# Required: signs the session cookie that gates /api/enrich and /api/recommend.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
